# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Merriam-Webster Learner's Dictionary API
VITE_MW_LEARNERS_KEY=your-mw-api-key

# ElevenLabs (audio generation — admin only)
# API key goes in Netlify env as ELEVENLABS_API_KEY (no VITE_ prefix — server-side only)
VITE_ELEVENLABS_VOICE_IDS=voice1,voice2

# Azure Speech (pronunciation assessment)
VITE_AZURE_SPEECH_KEY=your-azure-key
VITE_AZURE_SPEECH_REGION=eastus

# Pixabay (flashcard images — free API key from pixabay.com/api/docs/)
VITE_PIXABAY_API_KEY=your-pixabay-key

# Test data mode — populate TeacherDashboard with fake student data
# VITE_USE_TEST_DATA=true
